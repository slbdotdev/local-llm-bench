    "tools": {
     "write path=\"reengine.py\" content</arg_key><arg_value>\"\"\"reengine -- a backtracking regular-expression engine written from scratch.\n\nImplements the specified subset of Python's ``re`` semantics: capturing and\nnon-capturing groups, character classes, anchors, escapes, greedy and\nnon-greedy quantifiers (including bounded ``{m,n}`` forms) and alternation,\nwith leftmost-first, ordered depth-first backtracking matching.\n\"\"\"\n\nimport sys\nimport threading\n\n__all__ = [\"PatternError\", \"search\"]\n\n\nclass PatternError(ValueError):\n    \"\"\"Raised when a pattern is malformed.\"\"\"\n\n    def __init__(self, kind, message=None):\n        super().__init__(message if message is not None else kind)\n        self.kind = kind\n\n\n# ---------------------------------------------------------------------------\n# character predicates (ASCII only, per spec)\n\ndef _is_digit(c):\n    return \"0\" <= c <= \"9\"\n\n\ndef _is_word(c):\n    return (\"a\" <= c <= \"z\" or \"A\" <= c <= \"Z\"\n            or \"0\" <= c <= \"9\" or c == \"_\")\n\n\ndef _is_space(c):\n    return c in \" \\t\\n\\r\\f\\v\"\n\n\n# ---------------------------------------------------------------------------\n# matcher nodes.  Every node is a function\n#     node(text, pos, groups, k) -> final-result-or-None\n# where ``k`` is the continuation taking the position after this node's match.\n# ``groups`` is a list with one entry per capturing group (None or (gs, ge));\n# nodes that write to it restore the previous value when their continuation\n# fails, so that backtracking restores group spans.\n\ndef _make_lit(ch):\n    def node(text, pos, groups, k):\n        if pos < len(text) and text[pos] == ch:\n            return k(pos + 1)\n        return None\n    return node\n\n\ndef _dot_node(text, pos, groups, k):\n    if pos < len(text) and text[pos] != \"\\n\":\n        return k(pos + 1)\n    return None\n\n\ndef _caret_node(text, pos, groups, k):\n    if pos == 0:\n        return k(pos)\n    return None\n\n\ndef _dollar_node(text, pos, groups, k):\n    n = len(text)\n    if pos == n or (pos == n - 1 and text[n - 1] == \"\\n\"):\n        return k(pos)\n    return None\n\n\ndef _make_boundary(negated):\n    def node(text, pos, groups, k):\n        before = pos > 0 and _is_word(text[pos - 1])\n        after = pos < len(text) and _is_word(text[pos])\n        if (before != after) != negated:\n            return k(pos)\n        return None\n    return node\n\n\n_ESC_PREDS = {\n    \"d\": _is_digit,\n    \"D\": lambda c: not _is_digit(c),\n    \"w\": _is_word,\n    \"W\": lambda c: not _is_word(c),\n    \"s\": _is_space,\n    \"S\": lambda c: not _is_space(c),\n}\n\n\ndef _make_escape_class(X):\n    pred = _ESC_PREDS[X]\n\n    def node(text, pos, groups, k):\n        if pos < len(text) and pred(text[pos]):\n            return k(pos + 1)\n        return None\n    return node\n\n\ndef _make_class(negated, members):\n    \"\"\"members: list of ('c', ch) | ('r', lo, hi) | ('e', X).\"\"\"\n    singles = set()\n    ranges = []\n    escs = []\n    for m in members:\n        if m[0] == \"c\":\n            singles.add(m[1])\n        elif m[0] == \"r\":\n            ranges.append((ord(m[1]), ord(m[2])))\n        else:\n            escs.append(m[1])\n\n    def in_class(c):\n        if c in singles:\n            return True\n        o = ord(c)\n        for lo, hi in ranges:\n            if lo <= o <= hi:\n                return True\n        for X in escs:\n            if X == \"d\":\n                if _is_digit(c):\n                    return True\n            elif X == \"D\":\n                if not _is_digit(c):\n                    return True\n            elif X == \"w\":\n                if _is_word(c):\n                    return True\n            elif X == \"W\":\n                if not _is_word(c):\n                    return True\n            elif X == \"s\":\n                if _is_space(c):\n                    return True\n            else:  # 'S'\n                if not _is_space(c):\n                    return True\n        return False\n\n    def node(text, pos, groups, k):\n        if pos < len(text):\n            c = text[pos]\n            if in_class(c) != negated:\n                return k(pos + 1)\n        return None\n    return node\n\n\ndef _make_alt(branches):\n    if len(branches) == 1:\n        return branches[0]\n\n    def node(text, pos, groups, k):\n        for branch in branches:\n            r = branch(text, pos, groups, k)\n            if r is not None:\n                return r\n        return None\n    return node\n\n\ndef _make_concat(items):\n    if not items:\n        def node(text, pos, groups, k):\n            return k(pos)\n        return node\n    if len(items) == 1:\n        return items[0]\n    count = len(items)\n\n    def node(text, pos, groups, k):\n        def go(idx, p):\n            if idx == count:\n                return k(p)\n            return items[idx](text, p, groups,\n                              lambda p2, idx=idx: go(idx + 1, p2))\n        return go(0, pos)\n    return node\n\n\ndef _make_group(gidx, body):\n    def node(text, pos, groups, k):\n        old = groups[gidx]\n\n        def done(p2):\n            groups[gidx] = (pos, p2)\n            r = k(p2)\n            if r is None:\n                groups[gidx] = old\n            return r\n\n        return body(text, pos, groups, done)\n    return node\n\n\ndef _make_rep(body, lo, hi, greedy):\n    def node(text, pos, groups, k):\n        def rep(p, count, prev_start):\n            # mandatory iterations 1..lo\n            if count < lo:\n                return body(text, p, groups,\n                            lambda p2: rep(p2, count + 1, p))\n            # optional iteration: only if below hi and (no previous\n            # iteration, or the previous one consumed >= 1 character)\n            can_iter = ((hi is None or count < hi)\n                        and (count == 0 or p != prev_start))\n            if greedy:\n                if can_iter:\n                    r = body(text, p, groups,\n                             lambda p2: rep(p2, count + 1, p))\n                    if r is not None:\n                        return r\n                return k(p)\n            else:\n                r = k(p)\n                if r is not None:\n                    return r\n                if can_iter:\n                    return body(text, p, groups,\n                                lambda p2: rep(p2, count + 1, p))\n                return None\n        return rep(pos, 0, pos)\n    return node\n\n\n# ---------------------------------------------------------------------------\n# parser\n\n_SIMPLE_ESCAPES = {\"n\": \"\\n\", \"t\": \"\\t\", \"r\": \"\\r\", \"f\": \"\\f\", \"v\": \"\\v\"}\n\n\nclass _Parser:\n    def __init__(self, pattern):\n        self.s = pattern\n        self.n = len(pattern)\n        self.i = 0\n        self.ngroups = 0\n\n    def _err(self, kind, message):\n        raise PatternError(kind, \"%s (pattern %r, position %d)\"\n                           % (message, self.s, self.i))\n\n    def parse(self):\n        node = self._alternation()\n        if self.i < self.n:\n            # the only way _alternation stops early is a stray ')'\n            self._err(\"unbalanced_paren\", \"unbalanced parenthesis\")\n        return node\n\n    def _alternation(self):\n        branches = [self._branch()]\n        while self.i < self.n and self.s[self.i] == \"|\":\n            self.i += 1\n            branches.append(self._branch())\n        return _make_alt(branches)\n\n    def _branch(self):\n        items = []\n        while self.i < self.n and self.s[self.i] not in \"|)\":\n            items.append(self._item())\n        return _make_concat(items)\n\n    def _item(self):\n        atom, is_anchor = self._atom()\n        q = self._quantifier()\n        if q is not None:\n            lo, hi, greedy = q\n            # checks in spec order: bad_repeat, anchor_repeat, multiple_repeat\n            if hi is not None and lo > hi:\n                self._err(\"bad_repeat\", \"min repeat greater than max repeat\")\n            if is_anchor:\n                self._err(\"anchor_repeat\", \"quantifier on an anchor\")\n            if self._starts_quantifier():\n                self._err(\"multiple_repeat\", \"multiple repeat\")\n            atom = _make_rep(atom, lo, hi, greedy)\n        return atom\n\n    def _quantifier(self):\n        \"\"\"Consume a quantifier (and optional '?') if one starts here.\n\n        Returns (lo, hi, greedy) or None.  A '{' that is not a well-formed\n        bounded quantifier is left alone (it will be a literal atom).\n        \"\"\"\n        if self.i >= self.n:\n            return None\n        c = self.s[self.i]\n        if c == \"*\":\n            lo, hi = 0, None\n            self.i += 1\n        elif c == \"+\":\n            lo, hi = 1, None\n            self.i += 1\n        elif c == \"?\":\n            lo, hi = 0, 1\n            self.i += 1\n        elif c == \"{\":\n            scanned = self._scan_bounded(self.i)\n            if scanned is None:\n                return None\n            lo, hi, self.i = scanned\n        else:\n            return None\n        greedy = True\n        if self.i < self.n and self.s[self.i] == \"?\":\n            greedy = False\n            self.i += 1\n        return (lo, hi, greedy)\n\n    def _starts_quantifier(self):\n        if self.i >= self.n:\n            return False\n        c = self.s[self.i]\n        if c in \"*+?\":\n            return True\n        if c == \"{\" and self._scan_bounded(self.i) is not None:\n            return True\n        return False\n\n    def _scan_bounded(self, i):\n        \"\"\"i points at '{'.  Without consuming, return (lo, hi, end_index)\n        when a well-formed bounded quantifier starts there, else None.\"\"\"\n        s, n = self.s, self.n\n        j = i + 1\n        lo_digits = []\n        while j < n and \"0\" <= s[j] <= \"9\":\n            lo_digits.append(s[j])\n            j += 1\n        if j < n and s[j] == \"}\" and lo_digits:\n            v = int(\"\".join(lo_digits))\n            return (v, v, j + 1)\n        if j < n and s[j] == \",\":\n            j += 1\n            hi_digits = []\n            while j < n and \"0\" <= s[j] <= \"9\":\n                hi_digits.append(s[j])\n                j += 1\n            if j < n and s[j] == \"}\":\n                if not lo_digits and not hi_digits:\n                    return None  # '{,}' is a literal, per spec\n                lo = int(\"\".join(lo_digits)) if lo_digits else 0\n                hi = int(\"\".join(hi_digits)) if hi_digits else None\n                return (lo, hi, j + 1)\n        return None\n\n    def _atom(self):\n        c = self.s[self.i]\n        if c == \"(\":\n            return self._group()\n        if c == \"[\":\n            return self._class(), False\n        if c == \".\":\n            self.i += 1\n            return _dot_node, False\n        if c == \"^\":\n            self.i += 1\n            return _caret_node, True\n        if c == \"$\":\n            self.i += 1\n            return _dollar_node, True\n        if c == \"\\\\\":\n            return self._escape_atom()\n        if c in \"*+?\":\n            self._err(\"nothing_to_repeat\", \"nothing to repeat\")\n        if c == \"{\":\n            if self._scan_bounded(self.i) is not None:\n                self._err(\"nothing_to_repeat\", \"nothing to repeat\")\n            self.i += 1\n            return _make_lit(\"{\"), False\n        self.i += 1\n        return _make_lit(c), False\n\n    def _group(self):\n        self.i += 1  # '('\n        gidx = None\n        if self.i < self.n and self.s[self.i] == \"?\":\n            if self.i + 1 < self.n and self.s[self.i + 1] == \":\":\n                self.i += 2\n            else:\n                self._err(\"bad_group\", \"unknown extension (?...)\")\n        else:\n            gidx = self.ngroups\n            self.ngroups += 1\n        body = self._alternation()\n        if self.i < self.n and self.s[self.i] == \")\":\n            self.i += 1\n        else:\n            self._err(\"unbalanced_paren\", \"missing ), unterminated subpattern\")\n        if gidx is None:\n            return body, False\n        return _make_group(gidx, body), False\n\n    def _escape_atom(self):\n        # self.s[self.i] == '\\\\'\n        if self.i + 1 >= self.n:\n            self._err(\"trailing_backslash\", \"trailing backslash\")\n        X = self.s[self.i + 1]\n        self.i += 2\n        if X in \"dDwWsS\":\n            return _make_escape_class(X), False\n        if X in _SIMPLE_ESCAPES:\n            return _make_lit(_SIMPLE_ESCAPES[X]), False\n        if X == \"b\":\n            return _make_boundary(False), True\n        if X == \"B\":\n            return _make_boundary(True), True\n        if (\"A\" <= X <= \"Z\" or \"a\" <= X <= \"z\" or \"0\" <= X <= \"9\"):\n            self._err(\"bad_escape\", \"bad escape \\\\%s\" % X)\n        return _make_lit(X), False\n\n    def _class(self):\n        self.i += 1  # '['\n        negated = False\n        if self.i < self.n and self.s[self.i] == \"^\":\n            negated = True\n            self.i += 1\n        members = []\n        first = True\n        while True:\n            if self.i >= self.n:\n                self._err(\"unterminated_class\", \"unterminated character class\")\n            c = self.s[self.i]\n            if c == \"]\" and not first:\n                self.i += 1\n                break\n            m = self._class_member(first)\n            first = False\n            if (self.i < self.n and self.s[self.i] == \"-\"\n                    and self.i + 1 < self.n and self.s[self.i + 1] != \"]\"):\n                self.i += 1  # '-'\n                m2 = self._class_member(False)\n                if m[0] == \"e\" or m2[0] == \"e\":\n                    self._err(\"bad_range\", \"bad character range\")\n                lo, hi = ord(m[1]), ord(m2[1])\n                if lo > hi:\n                    self._err(\"bad_range\", \"bad character range\")\n                members.append((\"r\", chr(lo), chr(hi)))\n            else:\n                members.append(m)\n        return _make_class(negated, members)\n\n    def _class_member(self, first):\n        s, n = self.s, self.n\n        c = s[self.i]\n        if first and c == \"]\":\n            self.i += 1\n            return (\"c\", \"]\")\n        if c == \"\\\\\":\n            if self.i + 1 >= n:\n                self._err(\"trailing_backslash\", \"trailing backslash in class\")\n            X = s[self.i + 1]\n            self.i += 2\n            if X in \"dDwWsS\":\n                return (\"e\", X)\n            if X in _SIMPLE_ESCAPES:\n                return (\"c\", _SIMPLE_ESCAPES[X])\n            if X == \"b\":\n                return (\"c\", \"\\x08\")\n            if X == \"B\":\n                self._err(\"bad_escape\", \"\\\\B in character class\")\n            return (\"c\", X)\n        self.i += 1\n        return (\"c\", c)\n\n\ndef parse_pattern(pattern):\n    \"\"\"Parse a pattern; returns (node, number_of_capturing_groups).\"\"\"\n    if not isinstance(pattern, str):\n        raise TypeError(\"pattern must be str\")\n    parser = _Parser(pattern)\n    return parser.parse(), parser.ngroups\n\n\n# ---------------------------------------------------------------------------\n# search\n\ndef _match_all(node, ngroups, text):\n    if not isinstance(text, str):\n        raise TypeError(\"text must be str\")\n    groups = [None] * ngroups\n    for start in range(len(text) + 1):\n        end = node(text, start, groups, lambda p: p)\n        if end is not None:\n            return (start, end, list(groups))\n    return None\n\n\ndef search(pattern, text):\n    \"\"\"Search ``text`` for the leftmost match of ``pattern``.\n\n    Returns None when there is no match, else ``(start, end, groups)``.\n    Raises PatternError for a malformed pattern.\n    \"\"\"\n    node, ngroups = parse_pattern(pattern)\n    box = {}\n\n    def runner():\n        try:\n            box[\"result\"] = _match_all(node, ngroups, text)\n        except BaseException as exc:  # re-raised in the calling thread\n            box[\"error\"] = exc\n\n    old_limit = sys.getrecursionlimit()\n    sys.setrecursionlimit(max(old_limit, 500000))\n    thread = None\n    try:\n        # run the (deeply recursive) match on a thread with a large stack\n        for size in (512 * 1024 * 1024, 64 * 1024 * 1024):\n            try:\n                threading.stack_size(size)\n                thread = threading.Thread(target=runner)\n                thread.start()\n                break\n            except (ValueError, RuntimeError, OverflowError):\n                thread = None\n                continue\n        if thread is not None:\n            thread.join()\n        else:\n            runner()\n    finally:\n        sys.setrecursionlimit(old_limit)\n    if \"error\" in box:\n        raise box[\"error\"]\n    return box[\"result\"]\n</arg_value>": 1,
     "write path=\"test_reengine.py\" content</arg_key><arg_value>\"\"\"Quick self-checks for reengine.\"\"\"\nimport sys\n\nfrom reengine import search, PatternError\n\nfailures = []\n\n\ndef check(name, cond, info=None):\n    if not cond:\n        failures.append((name, info))\n\n\ndef expect_err(kind, pattern, text=\"\"):\n    try:\n        search(pattern, text)\n    except PatternError as e:\n        check(\"err:\" + repr(pattern), e.kind == kind, (e.kind, kind))\n        return\n    check(\"err:\" + repr(pattern), False, \"no error raised\")\n\n\n# --- spec examples ---------------------------------------------------------\ncheck(\"ex1\", search(\"a+b\", \"xaaab\") == (1, 5, []))\ncheck(\"ex2\", search(r\"(\\d+)-(\\d+)\", \"sum 12-345!\") == (4, 10, [(4, 6), (7, 10)]))\ncheck(\"ex3\", search(\"colou?r\", \"color\") == (0, 5, []))\ncheck(\"ex4\", search(\"^b\", \"ab\") is None)\ncheck(\"ex5\", search(\"(x)|(y)\", \"wy\") == (1, 2, [None, (1, 2)]))\n\n# --- literal meta characters ----------------------------------------------\ncheck(\"brace-lit\", search(\"a{x}\", \"a{x}\") == (0, 4, []))\ncheck(\"brace-lit2\", search(\"{\", \"{\") == (0, 1, []))\ncheck(\"a{2-lit\", search(\"a{2\", \"a{2\") == (0, 3, []))\ncheck(\"a{2,x}-lit\", search(\"a{2,x}\", \"xa{2,x}\") == (1, 7, []))\ncheck(\"a{}-lit\", search(\"a{}\", \"a{}\") == (0, 3, []))\ncheck(\"brk-lit\", search(\"]\", \"]\") == (0, 1, []))\ncheck(\"a-brace\", search(\"a{\", \"a{\") == (0, 2, []))\ncheck(\"a{,}-lit\", search(\"a{,}\", \"a{,}\") == (0, 4, []))\ncheck(\"a*{\", search(\"a*{\", \"a*{\") == (0, 3, []))\ncheck(\"a*{x}\", search(\"a*{x}\", \"a*{x}\") == (0, 5, []))\ncheck(\"a-comma-3\", search(\"a{,3}\", \"xa{,3}\") == (1, 6, []))\n\n# --- quantifiers -----------------------------------------------------------\ncheck(\"star\", search(\"a*\", \"baab\") == (0, 0, []))\ncheck(\"plus\", search(\"a+\", \"baab\") == (1, 3, []))\ncheck(\"opt\", search(\"colou?r\", \"colour\") == (0, 6, []))\ncheck(\"bounded\", s