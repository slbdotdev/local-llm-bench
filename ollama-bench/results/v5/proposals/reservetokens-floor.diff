--- a/roles/dotfiles/tasks/main.yml
+++ b/roles/dotfiles/tasks/main.yml
@@
+- name: Assert_Pi_Compaction_Reserve_Is_Sane
+  # reserveTokens is a *subtraction* from the model's window, not an absolute
+  # trigger: shouldCompact is `contextTokens > contextWindow - reserveTokens`.
+  # So a reserve at or above the window of the model in play makes the budget
+  # zero or negative and pi compacts on every single turn, which looks like a
+  # hung agent rather than a misconfiguration. The fleet figure (548576) is
+  # correct only while the default model has a ~1M window; vars.yml already
+  # says so in prose, and this turns that prose into a check that fails at
+  # converge time instead of at the first turn of a run.
+  #
+  # Half the window is the floor, not a tuning knob: at exactly half, every
+  # turn compacts as soon as the transcript passes the midpoint, which is
+  # already pathological. The intent is to catch an order-of-magnitude
+  # mismatch, so the assertion is deliberately loose.
+  ansible.builtin.assert:
+    that:
+      - agent_config_pi_settings.compaction.reserveTokens | int
+        < (agent_config_pi_default_context_window | int // 2)
+    fail_msg: >-
+      agent_config_pi_settings.compaction.reserveTokens
+      ({{ agent_config_pi_settings.compaction.reserveTokens }}) is at least half
+      the pinned context window for {{ agent_config_pi_settings.defaultModel }}
+      ({{ agent_config_pi_default_context_window }}). pi computes
+      `contextWindow - reserveTokens`, so this configuration compacts on every
+      turn. Change reserveTokens and the contextWindow pin together.
+    success_msg: "pi compaction reserve is below half the pinned window"
+    quiet: true
+  tags: [dotfiles]
+
 - name: Deploy_Pi_Settings
