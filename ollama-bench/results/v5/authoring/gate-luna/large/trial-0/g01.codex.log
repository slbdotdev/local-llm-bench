+def transform(records):
+    source_aliases = {
+        "core": "platform",
+        "svc": "service",
+        "web": "frontend",
+        "ui": "frontend",
+        "jobs": "worker",
+        "batch": "worker",
+    }
+    global_key_aliases = {
+        "err": "error",
+        "warn": "warning",
+        "lat": "latency",
+        "dur": "duration",
+        "cfg": "config",
+    }
+    source_key_aliases = {
+        "platform": {"compile": "build", "compilation": "build"},
+        "service": {"request": "requests", "req": "requests"},
+        "frontend": {"paint": "render", "draw": "render"},
+        "worker": {"job": "jobs", "task": "jobs"},
+    }
+    action_multipliers = {
+        "add": 1,
+        "remove": -1,
+        "adjust": 1,
+        "hold": 0,
+    }
+
+    result = []
+    buckets = {}
+    entry_positions = {}
+    label_sets = {}
+
+    for record in records:
+        source = record["source"].strip(" ")
+        source = source_aliases.get(source, source)
+
+        bucket = buckets.get(source)
+        if bucket is None:
+            bucket = {"source": source, "entries": []}
+            buckets[source] = bucket
+            entry_positions[source] = {}
+            label_sets[source] = []
+            result.append(bucket)
+
+        positions = entry_positions[source]
+        per_entry_labels = label_sets[source]
+
+        for change in record["changes"]:
+            action = change["action"]
+            if action not in action_multipliers:
+                continue
+
+            amount = change["delta"] * action_multipliers[action]
+            key = change["key"].strip(" ").casefold()
+            key = global_key_aliases.get(key, key)
+            key = source_key_aliases.get(source, {}).get(key, key)
+
+            entry_index = positions.get(key)
+            if entry_index is None:
+                labels = []
+                seen_labels = set()
+                for raw_label in change["labels"]:
+                    label = raw_label.strip(" ").casefold()
+                    if label and label not in seen_labels:
+                        labels.append(label)
+                        seen_labels.add(label)
+                entry = {
+                    "key": key,
+                    "total": amount,
+                    "occurrences": 1,
+                    "labels": labels,
+                }
+                positions[key] = len(bucket["entries"])
+                bucket["entries"].append(entry)
+                per_entry_labels.append(seen_labels)
+            else:
+                entry = bucket["entries"][entry_index]
+                entry["total"] += amount
+                entry["occurrences"] += 1
+                seen_labels = per_entry_labels[entry_index]
+                for raw_label in change["labels"]:
+                    label = raw_label.strip(" ").casefold()
+                    if label and label not in seen_labels:
+                        entry["labels"].append(label)
+                        seen_labels.add(label)
+
+    return result

