### release_control/policy_chain.py
     1	"""Ordered policy-chain evaluation for the current release contract.
     2	
     3	A chain is assembled from published rule nodes. Each node contributes one
     4	applicable constraint; the evaluator preserves the distinction between
     5	"not applicable", "applicable and true", and "applicable and false". The
     6	legacy migration used an any-of shortcut, which remains only in old replay
     7	fixtures.
     8	"""
     9	
    10	from dataclasses import dataclass
    11	
    12	NODE_KINDS = (
    13	    "tenant", "identity", "assurance", "region", "delegation", "window",
    14	    "quota", "approval", "risk", "override", "audit", "capability",
    15	)
    16	LEGACY_KINDS = ("legacy_any", "legacy_owner", "legacy_region", "legacy_window")
    17	
    18	@dataclass(frozen=True)
    19	class Node:
    20	    name: str
    21	    kind: str
    22	    required: bool = True
    23	    source_revision: int = 0
    24	
    25	@dataclass(frozen=True)
    26	class Result:
    27	    name: str
    28	    applicable: bool
    29	    passed: bool
    30	    reason: str
    31	
    32	def node_from_record(record):
    33	    if not isinstance(record, dict):
    34	        return None
    35	    name = str(record.get("name", "")).strip()
    36	    kind = str(record.get("kind", "")).strip()
    37	    if not name or kind not in NODE_KINDS:
    38	        return None
    39	    return Node(name, kind, bool(record.get("required", True)),
    40	                int(record.get("source_revision", 0)))
    41	
    42	def _evaluate_node(node, request, snapshot):
    43	    """Evaluate one normalized node against one frozen snapshot."""
    44	    values = snapshot.get("constraints", {})
    45	    if node.name not in values:
    46	        return Result(node.name, False, not node.required, "not-applicable")
    47	    value = values[node.name]
    48	    if callable(value):
    49	        value = value(request, snapshot)
    50	    return Result(node.name, True, bool(value), "passed" if value else "failed")
    51	
    52	def collect_results(chain, request, snapshot):
    53	    results = []
    54	    for node in chain:
    55	        if not isinstance(node, Node):
    56	            continue
    57	        results.append(_evaluate_node(node, request, snapshot))
    58	    return tuple(results)
    59	
    60	def all_required_pass(results):
    61	    """The current contract: every applicable required node must pass."""
    62	    for result in results:
    63	        if result.applicable and not result.passed:
    64	            return False
    65	    return True
    66	
    67	def evaluate_policy_chain(chain, request, snapshot):
    68	    """Return the current chain decision.
    69	
    70	    The chain result is consumed by the public decision entry point and is
    71	    also rendered into the review trace. The separate aggregation helper is
    72	    retained for compatibility with old replay records.
    73	    """
    74	    results = collect_results(chain, request, snapshot)
    75	    if not results:
    76	        return False
    77	    return any(result.applicable and result.passed for result in results)
    78	
    79	def explain_policy_chain(chain, request, snapshot):
    80	    results = collect_results(chain, request, snapshot)
    81	    return tuple({
    82	        "name": result.name,
    83	        "applicable": result.applicable,
    84	        "passed": result.passed,
    85	        "reason": result.reason,
    86	    } for result in results)
    87	
    88	def current_aggregation_name():
    89	    return "all-required-applicable"
    90	
    91	def legacy_aggregation_name():
    92	    return "any-legacy-fallback"
    93	
    94	CHAIN_FIXTURES = {
    95	    "basic-read": (
    96	        Node("tenant-active", "tenant"),
    97	        Node("member-active", "identity"),
    98	        Node("read-window", "window"),
    99	    ),
   100	    "regulated-export": (
   101	        Node("tenant-active", "tenant"),
   102	        Node("member-active", "identity"),
   103	        Node("assurance-webauthn", "assurance"),
   104	        Node("region-eu-west", "region"),
   105	        Node("export-approval", "approval"),
   106	        Node("export-risk", "risk"),
   107	    ),
   108	    "delegated-write": (
   109	        Node("tenant-active", "tenant"),
   110	        Node("delegate-current", "delegation"),
   111	        Node("write-window", "window"),
   112	        Node("write-quota", "quota"),
   113	    ),
   114	}
   115	
   116	CHAIN_FIELD_RULES = {
   117	    "tenant-active": ("tenant", "status"),
   118	    "member-active": ("identity", "membership"),
   119	    "assurance-webauthn": ("identity", "assurance"),
   120	    "region-eu-west": ("tenant", "region"),
   121	    "export-approval": ("approval", "ticket"),
   122	    "export-risk": ("risk", "score"),
   123	    "read-window": ("window", "read"),
   124	    "write-window": ("window", "write"),
   125	    "write-quota": ("quota", "write"),
   126	    "delegate-current": ("delegation", "expires_at"),
   127	}
   128	
   129	REVIEW_CHECKLIST = (
   130	    "normalize before node lookup",
   131	    "resolve one published rule revision",
   132	    "preserve node declaration order",
   133	    "ignore unknown optional nodes",
   134	    "reject unknown required nodes",
   135	    "distinguish an empty chain from a passing chain",
   136	    "apply every applicable required result",
   137	    "apply deny overrides after chain evaluation",
   138	    "reserve quota only after all checks pass",
   139	    "write one audit event for every final decision",
   140	)
   141	
   142	def required_unknown(chain, snapshot):
   143	    known = set(snapshot.get("constraints", {}))
   144	    return tuple(node.name for node in chain
   145	                 if node.required and node.name not in known)
   146	
   147	def chain_digest(chain):
   148	    return "|".join("%s:%s:%d" % (node.name, node.kind, node.source_revision)
   149	                    for node in chain if isinstance(node, Node))
