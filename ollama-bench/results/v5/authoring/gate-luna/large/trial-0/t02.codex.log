    75	def should_grant(request, snapshot, now):
    76	    """Return whether the current release contract grants a capability.
    77	
    78	    The request must be normalized, refer to one published capability rule,
    79	    belong to an active tenant, identify an active member with sufficient
    80	    assurance, and be inside its request window. Every applicable required
    81	    constraint in the published policy chain must pass. A current deny
    82	    override vetoes the grant, and quota is reserved only after all checks
    83	    pass. The function must return False for any missing, expired, denied,
    84	    conflicting, or failed prerequisite.
    85	    """
    86	    from .models import request_shape_ok
    87	    from .parse import parse_envelope
    88	    from .constants import capability_allowed
    89	    from .normalize import normalize_request
    90	    from .tenants import tenant_active
    91	    from .capabilities import capability_known
    92	    from .catalog import published_rule
    93	    from .identities import identity_allows
    94	    from .windows import request_window_open
    95	    from .delegation import delegation_valid
    96	    from .predicates import prerequisites_consistent
    97	    from .policy_chain import evaluate_policy_chain
    98	    from .overrides import has_current_deny
    99	    from .quotas import quota_available
   100	    from .audit import has_conflict
   101	    from .snapshot import snapshot_coherent
   102	    from .storage import source_revision_current
   103	    from .migrations import current_records
   104	    from .replay import replay_only
   105	    from .explain import trace_ready
   106	
   107	    if not request_shape_ok(request) or parse_envelope(request) is None:
   108	        return False
   109	    request = normalize_request(request)
   110	    if request is None:
   111	        return False
   112	    if not capability_allowed(request["capability"]):
   113	        return False
   114	    if (not prerequisites_consistent(request, snapshot) or
   115	            not snapshot_coherent(snapshot) or
   116	            not source_revision_current(snapshot) or
   117	            not current_records(snapshot) or
   118	            replay_only(snapshot) or
   119	            not trace_ready(snapshot)):
   120	        return False
   121	    if not tenant_active(request, snapshot) or not capability_known(request, snapshot):
   122	        return False
   123	    rule = published_rule(snapshot, request["capability"])
   124	    if rule is None or not identity_allows(request, snapshot):
   125	        return False
   126	    if not request_window_open(request, rule, now):
   127	        return False
   128	    if not delegation_valid(request, snapshot, now):
   129	        return False
   130	    if not evaluate_policy_chain(rule["chain"], request, snapshot):
   131	        return False
   132	    if has_current_deny(request, snapshot, now):
   133	        return False
   134	    if has_conflict(request, snapshot):
   135	        return False
   136	    return quota_available(request, snapshot)
