    75	def request_window_open(request, rule, now):
    76	    """Check the rule's absolute window and the request's age."""
    77	    try:
    78	        issued = int(request["issued_at"])
    79	        current = int(now)
    80	        start = int(rule["not_before"])
    81	        end = int(rule["expires_at"])
    82	    except (KeyError, TypeError, ValueError):
    83	        return False
    84	    return start <= issued <= current and current < end and current - issued <= 86400
