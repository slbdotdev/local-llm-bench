    75	def identity_allows(request, snapshot):
    76	    """Require an active member and the assurance level named by the rule."""
    77	    identities = snapshot.get("identities", {})
    78	    identity = identities.get(request.get("subject"))
    79	    if not isinstance(identity, dict) or identity.get("status") != "active":
    80	        return False
    81	    if request.get("tenant") not in identity.get("tenants", ()):
    82	        return False
    83	    needed = snapshot.get("required_assurance", {}).get(
    84	        request.get("capability"), "mfa")
    85	    levels = {"password": 1, "mfa": 2, "webauthn": 3, "certificate": 4}
    86	    return levels.get(identity.get("assurance"), 0) >= levels.get(needed, 99)
