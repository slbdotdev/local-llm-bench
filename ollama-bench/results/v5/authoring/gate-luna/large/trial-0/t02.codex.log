    75	def normalize_request(request):
    76	    """Return the canonical request mapping or None for malformed input."""
    77	    if not isinstance(request, dict):
    78	        return None
    79	    required = ("tenant", "subject", "capability", "issued_at")
    80	    if any(not str(request.get(key, "")).strip() for key in required):
    81	        return None
    82	    result = dict(request)
    83	    result["tenant"] = str(result["tenant"]).strip().casefold()
    84	    result["subject"] = str(result["subject"]).strip().casefold()
    85	    result["capability"] = str(result["capability"]).strip().casefold()
    86	    result["region"] = str(result.get("region", "")).strip().casefold()
    87	    result["scopes"] = tuple(sorted(set(str(x).strip().casefold()
    88	                                        for x in result.get("scopes", ()))))
    89	    result["tags"] = tuple(sorted(set(str(x).strip() for x in result.get("tags", ()))))
    90	    return result
