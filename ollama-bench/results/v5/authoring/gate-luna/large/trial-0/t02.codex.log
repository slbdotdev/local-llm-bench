    75	def has_current_deny(request, snapshot, now):
    76	    """Find a non-expired deny matching tenant, subject, and capability."""
    77	    for row in snapshot.get("overrides", ()):
    78	        if row.get("effect") != "deny":
    79	            continue
    80	        if row.get("expires_at", 0) <= now:
    81	            continue
    82	        if row.get("tenant") not in (None, request.get("tenant")):
    83	            continue
    84	        if row.get("subject") not in (None, request.get("subject")):
    85	            continue
    86	        if row.get("capability") not in (None, request.get("capability")):
    87	            continue
    88	        return True
    89	    return False
