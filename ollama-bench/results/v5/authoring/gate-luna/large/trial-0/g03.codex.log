new file mode 100644
index 0000000000000000000000000000000000000000..fa68efedd44465c624a59b75dcd603565691fa91
--- /dev/null
+++ b/ollama-bench/results/v5/authoring/gate-luna/large/trial-0/g03/.migrate_make_badge.py
@@ -0,0 +1,30 @@
+import ast
+from pathlib import Path
+
+
+for path in [*Path("badges").rglob("*.py"), Path("tests/test_badges.py")]:
+    source = path.read_bytes()
+    tree = ast.parse(source, filename=str(path))
+    lines = source.splitlines(keepends=True)
+    starts = []
+    offset = 0
+    for line in lines:
+        starts.append(offset)
+        offset += len(line)
+    edits = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call) or len(node.args) < 2:
+            continue
+        function = node.func
+        is_make_badge = (isinstance(function, ast.Name) and function.id == "make_badge")
+        is_make_badge = is_make_badge or (
+            isinstance(function, ast.Attribute) and function.attr == "make_badge"
+        )
+        if not is_make_badge:
+            continue
+        argument = node.args[1]
+        position = starts[argument.lineno - 1] + argument.col_offset
+        edits.append(position)
+    for position in sorted(edits, reverse=True):
+        source = source[:position] + b"tone=" + source[position:]
+    path.write_bytes(source)
