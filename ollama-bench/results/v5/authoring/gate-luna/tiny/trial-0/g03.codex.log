def reflected(event, *, channel="main", stamped=False):
    writer = getattr(event_core, "publish_event", _fallback)
    return writer(event[1], event[0], channel=channel, stamped=stamped)
import doctest

import event_core
import event_view


def test_suite():
    assert doctest.testmod(event_core).failed == 0
    assert event_core.publish_event("disk", "alarm", channel="ops") == "ops|alarm|disk"
    assert event_core.batch([("one", "a"), ("two", "b")]) == ["main|a|one", "main|b|two"]
    assert event_view.reflected(("cache", "notice"), channel="audit", stamped=True) == "STAMP audit|notice|cache"


if __name__ == "__main__":
    test_suite()

