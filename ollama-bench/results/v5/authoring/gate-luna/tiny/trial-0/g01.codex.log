+
+        if char == '"':
+            result.append(char)
+            backslashes = 0
+            preceding = index - 1
+            while preceding >= 0 and record[preceding] == "\\":
+                backslashes += 1
+                preceding -= 1
+            if backslashes % 2 == 0:
+                quoted = not quoted
+            index += 1
