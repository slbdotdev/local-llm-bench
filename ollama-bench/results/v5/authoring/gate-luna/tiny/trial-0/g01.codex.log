@@ -0,0 +1,70 @@
+"""Implementation of the lexical transformation described in specification.py."""
+
+
+def _is_ascii_digit(char: str) -> bool:
+    return "0" <= char <= "9"
+
+
+def _is_blocking_side_character(char: str) -> bool:
+    return (
+        "A" <= char <= "Z"
+        or "a" <= char <= "z"
+        or "0" <= char <= "9"
+        or char == "_"
+    )
+
+
+def _transform_record(record: str) -> str:
+    result: list[str] = []
+    quoted = False
+    wrapped = 0
+    index = 0
+
+    while index < len(record):
+        char = record[index]
+
+        if not quoted and char == "#" and (index == 0 or record[index - 1] == " "):
+            result.append(record[index:])
+            break
+
+        if char == '"':
+            result.append(char)
+            backslashes = 0
+            preceding = index - 1
+            while preceding >= 0 and record[preceding] == "\\":
+                backslashes += 1
+                preceding -= 1
+            if backslashes % 2 == 0:
+                quoted = not quoted
+            index += 1
+            continue
+
+        if not quoted and _is_ascii_digit(char):
+            end = index + 1
+            while end < len(record) and _is_ascii_digit(record[end]):
+                end += 1
+
+            left_blocked = index > 0 and _is_blocking_side_character(record[index - 1])
+            right_blocked = end < len(record) and _is_blocking_side_character(record[end])
+            if not left_blocked and not right_blocked:
+                result.extend(("<", record[index:end], ">"))
+                wrapped += 1
+                index = end
+                if wrapped == 2:
+                    result.append(record[index:])
+                    break
+                continue
+
+            result.append(record[index:end])
+            index = end
+            continue
+
+        result.append(char)
+        index += 1
+
+    return "".join(result)
+
+
+def transform(text: str) -> str:
+    """Apply the specified transformation independently to each LF-delimited record."""
+    return "\n".join(_transform_record(record) for record in text.split("\n"))

