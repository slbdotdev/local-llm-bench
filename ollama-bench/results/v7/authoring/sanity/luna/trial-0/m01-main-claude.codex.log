             record["payload"] = payload
         return record
 
+    def reap(self, ages):
+        """Abandon pending manifests that have exceeded the dispatch window."""
+        if self._sealed:
+            return 0
+        reaped = 0
+        for key, age in ages.items():
+            record = self._manifests.get(key)
+            if record is not None and record["state"] == "pending" and age > self.window_s:
+                record["state"] = "abandoned"
+                reaped += 1
+        return reaped
+
+    def active_count(self):
+        """Return the number of manifests still occupying dispatch capacity."""
+        return sum(record["state"] not in ("settled", "abandoned") for record in self._manifests.values())
+
     def seal(self):
         """Close the stage. Idempotent; see docs/operations.md on drain order."""
         self._sealed = True

