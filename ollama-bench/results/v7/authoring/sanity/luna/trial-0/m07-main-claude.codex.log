===== tools/gen_registry.py =====
#!/usr/bin/env python3
"""Regenerate src/kestrel/_registry_generated.py from config/manifest.json.

Run from the repository root. The output is deterministic: the same manifest always produces
the same file, byte for byte. That property is what lets the build check the generated file is
in sync rather than trusting that somebody remembered to run this.
"""
import json
import os

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "src", "kestrel", "_registry_generated.py")


def main():
    with open(os.path.join(ROOT, "config", "manifest.json"), encoding="utf-8") as fh:
        man = json.load(fh)
    lines = ['"""Generated from config/manifest.json by tools/gen_registry.py.',
             "",
             "DO NOT EDIT THIS FILE BY HAND. Change the manifest and regenerate.",
             '"""',
             "",
             "STAGE_CLASSES = {"]
    for stage in man["stages"]:
        lines.append('    "%s": ("%s", "%s"),' % (stage["name"], stage["module"], stage["class"]))
    lines.append("}")
    lines.append("")
    lines.append("")
    lines.append("def stage_names():")
    lines.append('    """Every stage name, in drain order."""')
    lines.append("    return list(STAGE_CLASSES)")
    lines.append("")
    with open(OUT, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(lines))


if __name__ == "__main__":
    main()
===== README.md =====
# kestrel-yard

A staged delivery pipeline. Each stage is a module under `src/`, is configured from one
section of the manifest, and is documented under `docs/`. The dated history of every
configuration decision is under `history/`.

## Reading order

1. `docs/architecture.md` - how the stages compose, and which order they drain in.
2. `docs/operations.md` - what to do when a stage refuses work.
3. `docs/policy/` - the rules that outrank both of the above.
4. `history/` - why each number is the number it is. **Dated, and superseded entries
   are kept**: a superseded entry is evidence, not a live instruction.

## Stages

| stage | module | doc | owner |
| --- | --- | --- | --- |
| envelope | `src/envelope_view.py` | `docs/envelope.md` | P. Ravindran |
| schema | `src/schema_flow.py` | `docs/schema.md` | J. Maldonado |
